# telegram-media-grabber — copy to .env and fill in. Never commit the .env file.
# Grabber reads this file automatically at startup (see media_bot/config.py).

# REQUIRED — token from @BotFather (/newbot). Treat it like a password.
# If this file is ever committed or shared, revoke the token immediately.
BOT_TOKEN=

# Who may use the bot. Comma-separated Telegram user ids; empty means everyone.
# Leave empty only if you intend a public bot.
ALLOWED_USER_IDS=

# Download limits
MAX_CONCURRENT=3
PER_USER_CONCURRENT=1
MAX_FILE_MB=2000
TEMP_TTL_MINUTES=90
DEDUPE_TTL_MINUTES=60
MAX_DOWNLOADS_PER_HOUR=30

# Encrypt the cookie vault (REQUIRED if users will upload private cookies).
# Generate with:  grabber keygen
COOKIE_ENC_KEY=
ALLOW_COOKIE_AUTH=true

# Sending large files.
# bot_api   -> 50 MB ceiling, no extra infrastructure (default)
# local_api -> 2 GB, needs a Local Bot API Server reachable at LOCAL_API_URL
# mtproto   -> 2 GB via a Telethon user session (see docs/large-files.md)
# auto      -> pick the strongest path that actually answers at startup
SEND_MODE=auto
LOCAL_API_URL=http://127.0.0.1:8081
# When the API server and the bot do not share a filesystem, map the two roots:
LOCAL_FILES_ROOT=
BOT_FILES_ROOT=

# Optional MTProto path (my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=grabber-mtproto

# Optional external tools
USE_ARIA2=true
ARIA2C_PATH=aria2c
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Storage and timeouts
DATA_DIR=data
REQUEST_TIMEOUT=45
READ_TIMEOUT=600
GRABBER_CONFIG=
